// The CSRs that the shell's csr command knows (main.c), in the order in
// which `csr` lists them: SHELL_CSR(<name as the assembler knows it>).
SHELL_CSR(mvendorid)
SHELL_CSR(marchid)
SHELL_CSR(mimpid)
SHELL_CSR(mhartid)
SHELL_CSR(misa)
SHELL_CSR(mstatus)
SHELL_CSR(mtvec)
SHELL_CSR(mie)
SHELL_CSR(mip)
SHELL_CSR(mscratch)
SHELL_CSR(mepc)
SHELL_CSR(mcause)
SHELL_CSR(mtval)
SHELL_CSR(mcountinhibit)
SHELL_CSR(mcycle)
SHELL_CSR(minstret)
SHELL_CSR(mhpmcounter3)
SHELL_CSR(mhpmcounter4)
SHELL_CSR(mhpmcounter5)
SHELL_CSR(mhpmcounter6)
SHELL_CSR(mhpmcounter7)
SHELL_CSR(mhpmcounter8)
SHELL_CSR(mhpmcounter9)
SHELL_CSR(mhpmcounter10)
