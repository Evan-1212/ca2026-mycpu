# SPDX-License-Identifier: MIT
# T3 block diagram: `make diagrams` renders it to block-diagram.svg (scripts/mkdiagram.py).
diagram 1000 640 "T3: CSRs, machine-mode traps, interrupts, counters and the CLINT"

group cpu 140 20 840 520 "CPU (mycpu.csrtrap)"
box IF 170 60 180 50 "InstructionFetch" "pc (T1)"
box ID 420 44 250 82 "InstructionDecode" "T2's table + Zicsr," "mret, wfi (tags)" "riscv.ImmGen"
box CSR 740 150 180 98 "CsrFile" "CSRs, trap entry," "mret, irq, hpm" "counters"
box EX 330 170 300 66 "Execute (T2)" "ALU, branch, target," "multiplier, divider"
box RF 740 300 180 50 "riscv.RegFile"
box MEM 280 300 180 66 "MemoryAccess" "(T1), enable"
box WB 520 300 150 66 "WriteBack" "(T1)"
box CTL 170 420 750 98 "CPU" "take_interrupt (3.9), exception priority (3.8)" "wfi wait (3.10), trap / commit (3.7)" "HpmClassifier: events"

arrow IF.e ID.w "inst"
arrow ID.s@0.45 532,170 "decoded, m"
arrow ID.e@0.5 830,85 CSR.n "csr, mret, wfi"
arrow CSR.w@0.4 630,189 "kill"
arrow EX.s@0.2 390,300 "alu_result"
arrow EX.s@0.8 570,300 "result"
arrow MEM.e WB.w "load"
arrow WB.e RF.w "regs"
arrow CSR.s@0.2 776,280 640,280 640,300 "rdata"
arrow EX.w 260,203 260,110 "redirect"
arrow 196,420 196,110 "commit / trap"
arrow CTL.e 950,469 950,199 CSR.e "events"
arrow 20,85 IF.w both "imem"
arrow 20,333 MEM.w both "dmem"
arrow 300,580 300,518 "msip, mtip, time"
arrow 520,580 520,518 "meip"
arrow 760,518 760,580 "retire (TrapRetire, with mip)"

text 20 610 "Top (module SimTop): riscv.Ram, DataBus (RAM, UART, SimCtrl, CLINT), Uart, SimCtrl, Clint"
text 20 630 "The redirect also carries the handler (mtvec) on a trap and mepc on an mret."
