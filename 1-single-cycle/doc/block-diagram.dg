# SPDX-License-Identifier: MIT
# T1 block diagram: `make diagrams` renders it to block-diagram.svg (scripts/mkdiagram.py).
diagram 900 790 "T1: the single-cycle CPU and its system"

group cpu 140 20 740 430 "CPU"
box IF 180 60 170 50 "InstructionFetch" "pc register"
box ID 430 52 200 66 "InstructionDecode" "riscv.Decoder" "riscv.ImmGen"
box EX 430 170 200 66 "Execute" "riscv.Alu" "riscv.BranchUnit"
box RF 700 178 150 50 "riscv.RegFile"
box MEM 430 280 200 66 "MemoryAccess" "strobes, lanes" "riscv.LoadExtend"
box WB 700 288 150 50 "WriteBack" "rd select"
box CTL 180 380 670 50 "CPU" "halt cause, commit, retire record"

arrow IF.e ID.w "inst"
arrow ID.s EX.n "decoded"
arrow RF.w EX.e "rs1, rs2"
arrow EX.s MEM.n "alu_result"
arrow MEM.e WB.w "load value"
arrow WB.n RF.s "reg_wen, wdata"
arrow EX.w 300,203 300,110 "redirect"
arrow 196,380 196,110 "commit"
arrow WB.s 775,380 "rd"
arrow 20,85 IF.w both "imem"
arrow 20,313 MEM.w both "dmem"
arrow 360,430 360,470 "retire (TrapRetire)"
arrow 640,430 640,470 "halted"

group top 20 490 860 290 "Top: module SimTop, the Verilator top"
box core 50 590 110 50 "CPU"
box bus 260 570 150 120 "DataBus" "address decode"
box ram 560 515 290 46 "riscv.Ram" "4 MiB at 0x8000_0000"
box uart 560 590 290 46 "mycpu.common.Uart" "0x1000_0000, 4 KiB"
box simctrl 560 650 290 46 "mycpu.common.SimCtrl" "0x1000_1000, 4 KiB"
arrow core.n 105,530 560,530 "imem: fetch port"
arrow bus.n 335,550 560,550 "data port"
arrow core.e 260,615 "dmem"
arrow 410,613 uart.w "0x1000_0xxx"
arrow 410,673 simctrl.w "0x1000_1xxx"
arrow bus.s 335,740 "any other address"
text 345 765 "error: the core halts (BadAddress)"
