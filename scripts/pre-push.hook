#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

# Verifies the history and runs the cheap source checks before pushing to main

# Ensure that the common script exists and is readable, then verify it has no
# syntax errors and defines the required function.
common_script="$(dirname "$0")/../../scripts/common.sh"
[ -r "$common_script" ] || { echo "[!] '$common_script' not found or not readable." >&2; exit 1; }
bash -n "$common_script" >/dev/null 2>&1 || { echo "[!] '$common_script' contains syntax errors." >&2; exit 1; }
source "$common_script"
declare -F set_colors >/dev/null 2>&1 || { echo "[!] '$common_script' does not define the required function." >&2; exit 1; }

set_colors

protected_branch='main'
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

# Show helpful hints for common issues
show_hints() {
  echo -e "${YELLOW}Hint${NC}: If Git keeps asking for your password, see:"
  echo -e "      https://docs.github.com/en/get-started/getting-started-with-git/why-is-git-always-asking-for-my-password"
  echo ""
}

# Run the cheap source checks for the protected branch. Scala formatting and the
# tests take minutes (sbt): run "make check-format" and the task tests yourself;
# the CI of the repository runs them on every push.
run_build_checks() {
  echo -e "${YELLOW}Running pre-push checks for $protected_branch branch...${NC}"
  echo ""

  printf "${YELLOW}Checking C and C++ formatting and the lint flags...${NC}"
  local out
  out=$(make --no-print-directory check-lint-flags 2>&1 && "${CLANG_FORMAT:-clang-format}" --dry-run --Werror \
          $(make -s --no-print-directory format-c-files) 2>&1)
  if [ $? -ne 0 ]; then
    printf " [ ${RED}FAIL${NC} ]\n"
    echo ""
    echo "$out" | tail -20
    echo ""
    echo -e "${RED}Please fix the errors before pushing to $protected_branch${NC}"
    return 1
  fi
  printf " [ ${GREEN}OK${NC} ]\n"
  return 0
}

# Main execution
main() {
  show_hints

  # The tools of the hooks, as advice: a push is judged by the history, not by this machine.
  "$(dirname "$0")/../../scripts/check-prereq.sh" > /dev/null 2>&1 ||
    echo -e "${YELLOW}Hint${NC}: scripts/check-prereq.sh reports a problem with the tools of the hooks (make prereq)"

  # Every push needs a history that continues the hash chain of Change-Ids.
  local local_ref local_oid remote_ref remote_oid
  while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    "$(dirname "$0")/../../scripts/chain.sh" verify "$local_oid" || exit 1
  done

  # Check if pushing to protected branch
  if [ "$current_branch" = "$protected_branch" ]; then
    if ! run_build_checks; then
      exit 1
    fi

    echo ""
    echo -e "${GREEN}All pre-push checks passed!${NC}"
    echo -e "${GREEN}Pushing to $protected_branch...${NC}"
    echo ""
  else
    echo -e "${CYAN}Pushing to branch: $current_branch${NC}"
    echo -e "${CYAN}(Pre-push checks are only run for $protected_branch)${NC}"
    echo ""
  fi

  exit 0
}

# Handle script interruption gracefully
trap 'echo -e "\n${YELLOW}Pre-push hook interrupted${NC}"; exit 130' INT TERM

main "$@"
